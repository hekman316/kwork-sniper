# ============================================================
#  Kwork Sniper — конфигурация
#  Скопируй этот файл в .env и заполни значения:
#      cp .env.example .env      (Linux/macOS)
#      copy .env.example .env    (Windows)
#  Файл .env в git НЕ попадает (см. .gitignore).
# ============================================================

# --- Telegram (обязательно) ---
# Токен бота от @BotFather (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=
# Твой chat_id. Узнать: напиши @userinfobot. Для группы — отрицательное число.
TELEGRAM_CHAT_ID=

# --- Категории Kwork ---
# Коды категорий через запятую. 41 = «Скрипты и боты».
# Список всех кодов:  python -m kwork_sniper.categories
KWORK_CATEGORIES=41

# --- Фильтры (опционально; пусто или 0 = выключено) ---
# Ключевые слова через запятую. Проект пройдёт, если найдено ХОТЯ БЫ ОДНО
# в названии или описании. Пусто = слать все проекты категории.
KEYWORDS=бот,telegram,парсер,парсинг,скрипт,автоматизация,python,api
# Стоп-слова: если найдено любое — проект отбрасывается.
EXCLUDE_KEYWORDS=
# Минимальный бюджет (₽). 0 = без фильтра.
MIN_BUDGET=0
# Максимум откликов: пропускать проекты, где откликов больше этого числа
# (низкая конкуренция = выше шанс). 0 = без фильтра.
MAX_OFFERS=0

# --- Поллинг ---
# Интервал опроса в секундах (рекомендуется 60–90).
POLL_INTERVAL=75
# Сколько страниц проверять на категорию (≈12 проектов/стр). 0 = все страницы.
MAX_PAGES=0

# --- Прочее ---
# Файл базы виденных проектов (для антидублей между перезапусками).
DB_PATH=seen.db
# Уровень логов: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
