# ============================================================
#  Kwork Sniper — конфигурация
# ============================================================
#  Как пользоваться:
#    1. Скопируй этот файл в .env:
#         Windows:        copy .env.example .env
#         Linux / macOS:  cp .env.example .env
#    2. Заполни значения ниже (как минимум — раздел Telegram).
#    3. Запусти:  python -m kwork_sniper
#
#  ВАЖНО: файл .env содержит секреты и в git НЕ попадает (см. .gitignore).
#  Никогда не публикуй свой .env и не коммить токен.
# ============================================================


# ────────────────────────────────────────────────────────────
#  TELEGRAM (обязательно)
# ────────────────────────────────────────────────────────────

# Токен бота. Где взять:
#   1. Открой @BotFather → команда /newbot
#   2. Задай имя и username бота → BotFather пришлёт токен вида
#      123456789:AAE...  — скопируй его сюда.
#   3. ОБЯЗАТЕЛЬНО напиши своему боту любое сообщение (нажми Start),
#      иначе он не сможет тебе писать.
TELEGRAM_BOT_TOKEN=

# Твой chat_id (куда слать уведомления).
#   - Личные сообщения: напиши @userinfobot — он пришлёт твой numeric Id.
#   - Группа/канал: добавь бота туда и используй id группы (обычно с минусом, напр. -1001234567890).
TELEGRAM_CHAT_ID=


# ────────────────────────────────────────────────────────────
#  ПРОКСИ ДЛЯ TELEGRAM (нужен, если api.telegram.org заблокирован — напр. в РФ)
# ────────────────────────────────────────────────────────────
# Если оставить пустым — бот подключается к Telegram напрямую.
# Прокси применяется ТОЛЬКО к Telegram; Kwork опрашивается напрямую.
#
# Формат:  scheme://username:password@host:port
#   scheme — один из: http, socks5, socks4
#   Без логина/пароля:  scheme://host:port
#
# Примеры:
#   HTTP:    TELEGRAM_PROXY=http://user:pass@138.249.118.198:63868
#   SOCKS5:  TELEGRAM_PROXY=socks5://user:pass@138.249.118.198:1080
#
# Если прокси выдан в виде "host:port:user:pass" (частый формат у продавцов),
# собери URL так:  scheme://user:pass@host:port
#
# Где взять прокси: любой платный residential/datacenter прокси-сервис
# (proxy6, proxys.io, и т.п.), либо собственный сервер. Бесплатные обычно
# нестабильны. Не уверен в типе (HTTP или SOCKS5) — попробуй сначала http://,
# затем socks5://.
TELEGRAM_PROXY=


# ────────────────────────────────────────────────────────────
#  КАТЕГОРИИ KWORK
# ────────────────────────────────────────────────────────────
# Коды категорий через запятую. 41 = «Скрипты и боты»
# (Telegram-боты, парсинг, автоматизация — основное здесь).
# Полный список всех кодов:   python -m kwork_sniper.categories
# Несколько категорий:        KWORK_CATEGORIES=41,38,80
KWORK_CATEGORIES=41


# ────────────────────────────────────────────────────────────
#  ФИЛЬТРЫ  (все опциональны; пусто или 0 = выключено)
# ────────────────────────────────────────────────────────────

# Ключевые слова через запятую. Проект пройдёт, если найдено ХОТЯ БЫ ОДНО
# в названии или описании. Пусто = слать все проекты выбранных категорий.
KEYWORDS=бот,telegram,парсер,парсинг,скрипт,автоматизация,python,api

# Стоп-слова: если найдено любое — проект отбрасывается (например: wordpress,1с).
EXCLUDE_KEYWORDS=

# Минимальный бюджет, ₽. Проекты дешевле — пропускаются. 0 = без фильтра.
MIN_BUDGET=0

# Максимум откликов (предложений): пропускать проекты, где откликов больше
# этого числа. Низкая конкуренция = выше шанс. Для снайпинга попробуй 3. 0 = выкл.
MAX_OFFERS=0

# --- Фильтры по заказчику ---
# Минимальный % найма: доля проектов заказчика, где он реально кого-то нанял.
# Высокий % = серьёзный заказчик, не «спрашиваю цену». Напр. 30. 0 = без фильтра.
# Внимание: у новичков (0–1 проект) процент недостоверен — сочетай с фильтром ниже.
MIN_HIRED_PERCENT=0

# Минимум опубликованных проектов у заказчика (отсечь новичков). Напр. 2. 0 = выкл.
MIN_CUSTOMER_PROJECTS=0


# ────────────────────────────────────────────────────────────
#  ПОЛЛИНГ
# ────────────────────────────────────────────────────────────

# Интервал опроса в секундах (рекомендуется 60–90; минимум 15).
POLL_INTERVAL=75

# Сколько страниц проверять на категорию (≈12 проектов на странице).
# 0 = все страницы (надёжно для нишевых категорий). Для очень больших
# категорий можно ограничить, напр. 3, чтобы не делать много запросов.
MAX_PAGES=0


# ────────────────────────────────────────────────────────────
#  ПРОЧЕЕ
# ────────────────────────────────────────────────────────────

# Файл базы виденных проектов (антидубли между перезапусками).
DB_PATH=seen.db

# Уровень логов: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
